/* ============================================================
   MODERNLAM COMPTABILITE - CLEAN WHITE & TEAL THEME
   ============================================================ */

/* --- 1. GLOBAL RESET & FONTS --- */
* {
    outline: none;
}

QMainWindow, QDialog {
    background-color: #f4f7fa;
}

QWidget {
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #2c3e50;
}

/* ============================================================
   2. SIDEBAR (القائمة الجانبية - تصميم أبيض عصري)
   ============================================================ */
QFrame#sidebar_container {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #e2e8f0;
}

#sidebar_title {
    font-size: 18px;
    font-weight: 800;
    color: #007572;
    background-color: transparent;
}

#sidebar_sub {
    font-size: 10px;
    font-weight: 600;
    color: #7f8c8d;
    background-color: transparent;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* أزرار التنقل الجانبية */
QPushButton[class="nav_button"] {
    background-color: transparent;
    color: #607d8b;
    border: none;
    padding: 12px 18px;
    text-align: left;
    font-size: 14px;
    font-weight: 600;
    margin: 3px 12px;
    border-radius: 8px;
}

QPushButton[class="nav_button"]:hover {
    background-color: #e0f2f1;
    color: #007572;
}

QPushButton[class="nav_button"]:checked {
    background-color: #007572;
    color: #ffffff;
    font-weight: 700;
}

/* ============================================================
   3. TABLES (الجداول)
   ============================================================ */
QTableWidget, QTableView {
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    gridline-color: #f1f5f9;
    selection-background-color: #e0f2f1;
    selection-color: #007572;
    alternate-background-color: #fafbfc;
}


/* الرؤوس الأفقية (الأعمدة) */
QHeaderView::section:horizontal {
    background-color: #ffffff;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #007572;
    border-right: 1px solid #f0f0f0;
    color: #007572;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
}

/* الرؤوس العمودية (أرقام الأسطر) */
QHeaderView::section:vertical {
    background-color: #f8f9fa;
    color: #607d8b;
    border: none;
    border-right: 1px solid #cfd8dc;
    border-bottom: 1px solid #f0f0f0;
    padding-left: 5px;
    padding-right: 5px;
    font-size: 12px;
    font-weight: 600;
    min-width: 30px;
    text-align: center;
}

QTableWidget::item:selected {
    background-color: #e0f2f1;
    color: #007572;
}

/* ============================================================
   4. BUTTONS (الأزرار)
   ============================================================ */
QPushButton {
    background-color: #ffffff;
    color: #007572;
    border: 1px solid #007572;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #007572;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #005f5c;
    color: #ffffff;
    border-color: #005f5c;
}

/* أزرار الحذف والرفض والمخاطر */
QPushButton[text^="Annuler"], QPushButton[text^="Supprimer"], QPushButton#secondary_btn {
    color: #e74c3c;
    border: 1px solid #e74c3c;
    background-color: #ffffff;
}

QPushButton[text^="Annuler"]:hover, QPushButton[text^="Supprimer"]:hover, QPushButton#secondary_btn:hover {
    background-color: #e74c3c;
    color: #ffffff;
}

/* ============================================================
   5. INPUTS (حقول الإدخال)
   ============================================================ */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #2c3e50;
    selection-background-color: #007572;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus {
    border: 2px solid #007572;
    background-color: #ffffff;
}

QLineEdit:read-only, QLineEdit:disabled, QComboBox:disabled {
    background-color: #f1f3f5;
    color: #90a4ae;
    border: 1px solid #e0e0e0;
}

/* ============================================================
   6. TABS & CONTAINERS (التبويبات والحاويات)
   ============================================================ */
QTabWidget::pane {
    border: 1px solid #cfd8dc;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    background: #ffffff;
    top: -1px;
}


QTabBar::tab {
    background: #eceff1;
    color: #607d8b;
    border: 1px solid transparent;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #007572;
    border-top: 3px solid #007572;
    border-bottom: 1px solid #ffffff;
}

QTabBar::tab:hover:!selected {
    background: #cfd8dc;
}

/* مجموعات GroupBox */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    margin-top: 25px;
    padding-top: 15px;
    font-weight: bold;
}

QScrollArea {
    border: 1px solid #cfd8dc;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    background-color: transparent;
}


QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    padding: 0 5px;
    color: #007572;
}

/* ============================================================
   7. SCROLLBARS (أشرطة التمرير)
   ============================================================ */
QScrollBar:vertical {
    border: none;
    background: #f4f7fa;
    width: 8px;
    border-radius: 4px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #b0bec5;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #007572;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ============================================================
   8. POPUPS (القوائم المنسدلة والتقويم)
   ============================================================ */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #007572;
    selection-background-color: #007572;
    selection-color: #ffffff;
    outline: none;
}

QCalendarWidget QWidget {
    background-color: #ffffff; 
    color: #2c3e50;
}

QCalendarWidget QToolButton {
    color: #2c3e50;
    background-color: transparent;
    font-weight: bold;
    border-radius: 4px;
    margin: 2px;
}

QCalendarWidget QToolButton:hover {
    background-color: #e0f2f1;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #ffffff;
    color: #2c3e50;
    selection-background-color: #007572;
    selection-color: #ffffff;
    border: none;
}

/* ============================================================
   9. GLOBAL WIDGET LIGHT LOCK
   Ensures every widget that Qt might paint with a system/dark
   colour is overridden to our light palette.
   ============================================================ */

/* All frames and generic containers */
QFrame, QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background-color: #f4f7fa;
    color: #2c3e50;
}

/* Dialogs and message boxes */
QDialog {
    background-color: #f4f7fa;
    color: #2c3e50;
}

QMessageBox {
    background-color: #f4f7fa;
    color: #2c3e50;
}

QMessageBox QLabel {
    color: #2c3e50;
    background-color: transparent;
}

/* Labels */
QLabel {
    color: #2c3e50;
    background-color: transparent;
}

/* Menus (context menus, drop-down menus) */
QMenu {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 8px 22px;
    background-color: transparent;
    color: #2c3e50;
}

QMenu::item:selected {
    background-color: #007572;
    color: #ffffff;
    border-radius: 4px;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 10px;
}

/* Tooltips */
QToolTip {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #007572;
    padding: 5px 8px;
    border-radius: 4px;
    font-size: 12px;
}

/* Splitters */
QSplitter::handle {
    background-color: #cfd8dc;
}

/* Status bar */
QStatusBar {
    background-color: #f4f7fa;
    color: #607d8b;
    border-top: 1px solid #e2e8f0;
}

/* Form layouts inside dialogs */
QFormLayout QLabel {
    color: #2c3e50;
    font-weight: 600;
}
